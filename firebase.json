{
  "functions": [{ "source": "functions", "codebase": "default", "runtime": "nodejs22" }],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json", "**/.*", "**/node_modules/**",
      "functions/**", "android-lockscreen/**",
      "README.md", "firestore.rules", "_config.yml", "tools/**"
    ],
    "headers": [
      { "source": "**", "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "no-cache" }
      ] }
    ],
    "rewrites": [
      { "source": "/play/**", "function": { "functionId": "codePlay", "region": "asia-northeast3" } }
    ]
  }
}
