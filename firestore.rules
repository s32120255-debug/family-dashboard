rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 계정 (소문자로 적기)
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'EMAIL1@gmail.com'
        ];
    }
    // 서윤 전용 계정: 서윤 보드(seoyun)는 이 계정만 열 수 있어요
    function isSeoyun() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'SEOYUN_EMAIL@gmail.com'
        ];
    }
    // 서윤 보드: 서윤만
    match /seoyun/{document=**} {
      allow read, write: if isSeoyun();
    }
    // 엄마 계정: 시훈이 대시보드 기록을 지우거나 엄마 화면을 볼 수 있어요
    function isMom() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'MOM_EMAIL@gmail.com'
        ];
    }
    // 시훈이 대시보드를 쓰는 계정: 시훈 + 엄마
    function isSihunBoard() {
      return isMom() || (request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'SIHUN_EMAIL@gmail.com'
        ]);
    }
    // 시훈이 대시보드: 시훈·엄마 계정만. 관리(설정·지우기)는 화면에서 관리자 비밀번호로 잠금.
    // 기록(log)은 고칠 수 없어요.
    match /sihunBoard/main {
      allow read, write: if isSihunBoard();
    }
    match /sihunBoard/mom {
      allow read, write: if isMom();
    }
    match /sihunBoard/main/{col}/{id} {
      allow read, create: if isSihunBoard();
      allow update: if isSihunBoard() && col != 'log';
      allow delete: if isSihunBoard();
    }
    // 가족 대시보드: 가족 모두 (seoyun, sihunBoard 는 빼고)
    match /{col}/{document=**} {
      allow read, write: if isFamily() && col != 'seoyun' && col != 'sihunBoard';
    }
  }
}
