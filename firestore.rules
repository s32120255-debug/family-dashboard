rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 가족 계정 (소문자로 적기)
    function isFamily() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'EMAIL1@gmail.com'
        ];
    }
    // 서윤 전용 계정: 서윤 보드(seoyun)는 이 계정만 열 수 있어요
    function isSeoyun() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'SEOYUN_EMAIL@gmail.com'
        ];
    }
    // 서윤 보드: 서윤만
    match /seoyun/{document=**} {
      allow read, write: if isSeoyun();
    }
    // 가족 대시보드: 가족 모두 (seoyun 은 빼고)
    match /{col}/{document=**} {
      allow read, write: if isFamily() && col != 'seoyun';
    }
  }
}
